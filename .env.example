# PayPilot environment template
# Copy to .env and fill in values. Never commit .env.

# App
APP_URL=http://localhost:3000
NODE_ENV=development

# PayPal Sandbox
# Get these from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Register APP_URL/api/webhooks/paypal as a webhook on the sandbox app.
PAYPAL_WEBHOOK_ID=
# Optional: sandbox personal (buyer) email used by `npm run paypal:seed`.
PAYPAL_SANDBOX_BUYER_EMAIL=

# AI (Anthropic Claude, tool use)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
MAX_AGENT_ROUNDS=5

# Persistence (SQLite)
DATABASE_PATH=data/paypilot.db

# Demo mode
# true  -> start with clearly-labelled fictional invoices
# false -> start in PayPal Sandbox mode (requires credentials)
# If omitted, demo mode is on only when PayPal credentials are absent.
DEMO_MODE=true

# Safety: PayPilot refuses non-sandbox PayPal base URLs unless this is true.
ALLOW_LIVE_PAYPAL=false
