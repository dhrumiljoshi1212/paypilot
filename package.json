{
  "name": "paypal-hackathon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node --env-file-if-exists=.env scripts/seed-demo.mjs",
    "paypal:seed": "node --env-file-if-exists=.env scripts/paypal-seed.mjs",
    "smoke": "node --env-file-if-exists=.env scripts/smoke-test.mjs",
    "webhook:list": "node --env-file-if-exists=.env scripts/paypal-webhook.mjs list",
    "webhook:register": "node --env-file-if-exists=.env scripts/paypal-webhook.mjs register",
    "webhook:events": "node --env-file-if-exists=.env scripts/paypal-webhook.mjs events",
    "webhook:update": "node --env-file-if-exists=.env scripts/paypal-webhook.mjs update",
    "webhook:delete": "node --env-file-if-exists=.env scripts/paypal-webhook.mjs delete"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "better-sqlite3": "^13.1.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.5"
  }
}
